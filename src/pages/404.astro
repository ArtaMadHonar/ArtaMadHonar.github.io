---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { ArrowLeft, Home } from 'lucide-react';
---

<BaseLayout
  title="صفحه پیدا نشد | استودیو آرتا ماد هنر"
  description="صفحه مورد نظر یافت نشد. بازگشت به صفحه اصلی استودیو آرتا ماد هنر."
>
  <div class="min-h-[60vh] flex items-center justify-center px-4 py-20 text-center">
    <div className="max-w-md space-y-6">
      <div className="w-20 h-20 mx-auto rounded-3xl bg-[#3E777A]/15 text-[#3E777A] dark:text-[#65B7B5] flex items-center justify-center font-mono font-black text-3xl">
        ۴۰۴
      </div>

      <div className="space-y-2">
        <h1 className="text-2xl sm:text-3xl font-black text-[#1E2424] dark:text-[#F2EFE9]">
          صفحه مورد نظر یافت نشد
        </h1>
        <p className="text-xs sm:text-sm text-[#434846] dark:text-[#BCC6C4] leading-relaxed">
          ممکن است آدرس صفحه تغییر کرده باشد یا موقتاً در دسترس نباشد.
        </p>
      </div>

      <div className="pt-2 flex justify-center">
        <a
          href="/"
          className="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-[#3E777A] hover:bg-[#326265] text-[#FAF8F4] text-xs sm:text-sm font-semibold transition-all shadow-md cursor-pointer"
        >
          <Home className="w-4 h-4" />
          <span>بازگشت به صفحه اصلی</span>
        </a>
      </div>
    </div>
  </div>
</BaseLayout>
